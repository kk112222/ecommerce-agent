# 环境变量模板 —— 复制为 .env 后填入真实值

# ===== LLM 配置 =====
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ===== OpenAI 备用配置（LLM_PROVIDER=openai 时生效）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 数据库 =====
# 默认值已在 config.py 里解析成项目根 data_v3.db 的绝对路径；
# 要换库（如 PostgreSQL）才需要在这里显式覆盖
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ecommerce

# ===== 安全 =====
# 签发 JWT 的密钥：**上线必须换掉**，否则别人能拿默认值伪造任意用户的 token。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440
# 本机证书链有问题时才置 false（仅影响 LLM 请求，默认必须校验）
LLM_VERIFY_SSL=true

# ===== 单轮对话预算（P2-11）=====
# ReAct 循环调几次工具由 LLM 自决，不给上限则成本/延迟不封顶；0 = 不限制
AGENT_BUDGET_TOKENS=120000
AGENT_BUDGET_SECONDS=240

# ===== 不需要配的服务 =====
# Redis：全项目零引用（曾用于会话缓存，现已由 SQLite 承担），不用装
# Qdrant：跑的是**本地文件模式**（backend/infrastructure/vector_store/qdrant_client.py
#         里 QC(path=...)，数据落在项目根 qdrant_data/），也没有独立服务要起
# 向量化与重排都走 DashScope 云 API，所以服务器只要能出网即可

# ===== 应用 =====
DEBUG=true
